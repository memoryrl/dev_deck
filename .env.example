NEXT_PUBLIC_SUPABASE_URL=https://tcmtqfpkyojqypbfnpgb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

STEAM_API_KEY=
STEAM_ID=

# 게시물 편집 관리자. 기본값 memoryrl@gmail.com
OWNER_EMAIL=memoryrl@gmail.com

# 관리자 계정의 사용자 UUID(선택, 권장). 설정하면 이메일이 같아도 이 UUID 의 계정만 관리자로 인정한다.
# Supabase → Authentication → Users 에서 관리자 계정의 UID 를 복사한다. DB 는 patch-security-hardening.sql 이 같은 값을 고정한다.
OWNER_USER_ID=

# 공개 사이트 주소. 프로덕션 OAuth 콜백에 필요 (끝 슬래시 없이)
NEXT_PUBLIC_SITE_URL=https://devdeck-blue.vercel.app

# Vercel Cron (Supabase 유휴 정지 방지) — 프로덕션에 필수
CRON_SECRET=

# 로컬은 코드가 127.0.0.1:11434 를 쓴다. 이 값은 Vercel 폴백용.
# 관리자 사이트 설정 > Ollama 주소(app_env)가 있으면 Vercel에서 그쪽이 우선한다.
# OLLAMA_BASE_URL=https://xxxx.trycloudflare.com

